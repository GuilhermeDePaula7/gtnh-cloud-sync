# Name of the Prism Launcher instance folder
INSTANCE_NAME="GTNH 2.9-Beta2"

# Google Drive target folder ID
DRIVE_FOLDER_ID="your_google_drive_folder_id_here"

# Data retention: maximum number of backups to keep in Google Drive (0 or unset = unlimited)
MAX_REMOTE_BACKUPS=10

# Optional: Custom path to the backups directory (leave commented to use default PrismLauncher path)
# BACKUP_DIR="~/.local/share/PrismLauncher/instances/GTNH 2.9-Beta2/.minecraft/backups/"
